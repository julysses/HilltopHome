# Set with: supabase secrets set --env-file supabase/functions/website-lead-intake/.env
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-injected at runtime by
# Supabase; listed here only for local `supabase functions serve` dev.)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# Comma-separated list of origins allowed to POST to this function.
ALLOWED_ORIGINS=https://www.hilltophomeco.com,http://localhost:3000
