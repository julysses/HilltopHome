# Public site URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.hilltophomeco.com

# Meta Pixel — client-side ID (public) and server-side Conversions API token
# (server-only, read by src/app/api/get-offer/route.ts, never exposed to the client)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# WholesaleOS lead intake — the FastAPI backend this site submits leads to.
# Server-only (used by src/app/api/get-offer/route.ts), never exposed to the client.
WHOLESALE_API_BASE=https://wholesale-automation.vercel.app

# Owner/team contact number shown on the site and used in fallback CTAs
NEXT_PUBLIC_OWNER_PHONE_DISPLAY=(214) 555-0100
NEXT_PUBLIC_OWNER_PHONE_TEL=+12145550100
